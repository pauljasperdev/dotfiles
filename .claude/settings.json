{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gsd-prompt-inject.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gsd-test-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/gsd-security-gate.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "preferences": {
    "codeStyle": {
      "gitCommitCoAuthor": false
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
