{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "keybinds": {
    "variant_cycle": "ctrl+x v"
  },
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "mode": {
    "build": {
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
    },
    "plan": {
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
    }
  },
  "provider": {
    "google": {
      "models": {
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  },
  "plugin": ["oh-my-opencode@latest"],
  "permission": {
    "bash": {
      "sst": "deny",
      "sst *": "deny",
      "* sst": "deny",
      "* sst *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "aws": "deny",
      "aws *": "deny",
      "* aws": "deny",
      "* aws *": "deny"
    }
  }
}
